# CDSE Sentinel Hub OAuth client (https://shapps.dataspace.copernicus.eu/dashboard/ → User settings → OAuth clients)
CDSE_SENTINEL_HUB_CLIENT_ID=
CDSE_SENTINEL_HUB_CLIENT_SECRET=
# ohsome API v2 key (free: https://account.heigit.org/signup). Optional; without it the slow v1 fallback is used.
OHSOME_API_KEY=
# DHARA_DATA_DIR=data
# DHARA_MAX_AOI_KM2=2500
# Gray area, keep false unless organisers approve (PLAN.md §3.3)
# ALLOW_FOUNDATION_WEIGHTS=false
# Kaggle GPU over the kaggle-terminal relay (training only; never used by the pipeline)
KAGGLE_RELAY_URL=
KAGGLE_RELAY_SECRET=
KAGGLE_KERNEL_ID=
# Optional CDSE S3 keys (https://eodata-s3keysmanager.dataspace.copernicus.eu) for DEM tiles; else open GLO-30 mirror
CDSE_S3_ACCESS_KEY=
CDSE_S3_SECRET_KEY=
