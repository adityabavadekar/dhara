# CDSE Sentinel Hub OAuth client (https://shapps.dataspace.copernicus.eu/dashboard/ → User settings → OAuth clients)
CDSE_SENTINEL_HUB_CLIENT_ID=
CDSE_SENTINEL_HUB_CLIENT_SECRET=
# ohsome API v2 key (free: https://account.heigit.org/signup). Optional; without it the slow v1 fallback is used.
OHSOME_API_KEY=
# DHARA_DATA_DIR=data
# DHARA_MAX_AOI_KM2=2500
# ImageNet encoder weights are allowed (organizer answer, 2026-10-13). Other pretrained weights: keep false.
# ALLOW_FOUNDATION_WEIGHTS=false
# Kaggle GPU over the kaggle-terminal relay (training only; never used by the pipeline)
KAGGLE_RELAY_URL=
KAGGLE_RELAY_SECRET=
KAGGLE_KERNEL_ID=
KAGGLE_KSSH=
# Optional CDSE S3 keys (https://eodata-s3keysmanager.dataspace.copernicus.eu) for DEM tiles; else open GLO-30 mirror
CDSE_S3_ACCESS_KEY=
CDSE_S3_SECRET_KEY=
# Assistant language model: auto (default: first provider with a key), off, groq, gemini or openai.
# Only the active provider's host is allowed; answers with numbers not in the results are discarded.
# ASSISTANT_LLM=auto
# GROQ_API_KEY=
# GEMINI_API_KEY=
# Several Gemini accounts, tried in turn when one is rate-limited (add _ACC_4, _ACC_5, ... as needed):
# GEMINI_API_KEY_ACC_1=
# GEMINI_API_KEY_ACC_2=
# OPENAI_API_KEY=
